{
	"name": "passforge",
	"description": "A secure password generation browser extension",
	"version": "1.0.0",
	"private": true,
	"packageManager": "pnpm@10.24.0",
	"engines": {
		"node": ">=18.0.0",
		"pnpm": ">=8.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.8",
		"@tailwindcss/cli": "^4.1.17",
		"@types/chai": "^5.2.3",
		"@types/chrome": "^0.1.32",
		"@types/mocha": "^10.0.10",
		"@types/node": "^24.10.1",
		"@types/sinon": "^21.0.0",
		"c8": "^10.1.3",
		"chai": "^5.3.3",
		"clean-webpack-plugin": "^4.0.0",
		"copy-webpack-plugin": "^13.0.1",
		"css-loader": "^7.1.2",
		"css-minimizer-webpack-plugin": "^7.0.2",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.7",
		"mini-css-extract-plugin": "^2.9.4",
		"mocha": "^10.8.2",
		"npm-run-all": "^4.1.5",
		"sinon": "^21.0.0",
		"style-loader": "^4.0.0",
		"tailwindcss": "^4.1.17",
		"terser-webpack-plugin": "^5.3.14",
		"ts-loader": "^9.5.4",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"webpack": "^5.103.0",
		"webpack-cli": "^6.0.1"
	},
	"scripts": {
		"test": "mocha",
		"test:watch": "mocha --watch",
		"test:coverage": "c8 mocha",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src tests",
		"lint:fix": "biome check --write src tests",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"validate": "pnpm typecheck && pnpm lint && pnpm test",
		"clean": "rm -rf build node_modules/.cache coverage",
		"prebuild": "pnpm run clean && pnpm run typecheck",
		"build-css": "pnpm exec tailwindcss -c ./tailwind.config.js -i ./src/ui/popup/style.css -o ./src/ui/popup/bundle.css",
		"build:chrome": "pnpm run build-css && webpack --config webpack_chrome.config.js",
		"build:firefox": "pnpm run build-css && webpack --config webpack_firefox.config.js",
		"build:prod": "run-p build:chrome build:firefox",
		"build": "pnpm test && pnpm run build:prod",
		"watch": "webpack --watch --config webpack_chrome.config.js",
		"ci": "pnpm typecheck && pnpm lint && pnpm test:coverage && pnpm run build:prod",
		"check": "pnpm outdated",
		"audit": "pnpm audit",
		"prepare": "husky"
	},
	"keywords": [
		"password-generator",
		"browser-extension",
		"chrome-extension",
		"firefox-addon",
		"security",
		"privacy"
	],
	"homepage": "https://github.com/eyepokes/passforge#readme",
	"bugs": {
		"url": "https://github.com/eyepokes/passforge/issues"
	},
	"repository": "github:eyepokes/passforge",
	"author": "eyepokes",
	"license": "ISC",
	"sideEffects": false,
	"browserslist": [
		"last 2 Chrome versions",
		"last 2 Firefox versions",
		"last 2 Edge versions"
	],
	"lint-staged": {
		"*.{ts,js,json,md}": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}

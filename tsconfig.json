{
	"compilerOptions": {
		"strict": true,
		"module": "commonjs",
		"target": "es6",
		"esModuleInterop": true,
		"sourceMap": false,
		"inlineSourceMap": false,
		"inlineSources": false,
		"noEmitOnError": false,
		"noImplicitAny": true,
		"typeRoots": ["node_modules/@types"],
		"resolveJsonModule": true,
		"outDir": "build",
		"removeComments": true,
		"types": ["node", "chrome"]
	},
	"ts-node": {
		"transpileOnly": true,
		"compilerOptions": {
			"module": "commonjs"
		}
	},
	"include": ["src/**/*", "tests/**/*"],
	"exclude": ["node_modules"]
}
